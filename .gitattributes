# Files whose exact bytes enter provenance fingerprints must have one checkout
# representation on every supported platform.
configs/*.toml text eol=lf
data/provenance/*.toml text eol=lf
data/provenance/population_runtime_mapping.json text eol=lf
tests/fixtures/*.json text eol=lf
inputs/** text eol=lf

# Evidence artifacts are content-addressed opaque bytes.  Never apply Git text
# conversion; a declared digest must describe the checked-out blob exactly.
data/provenance/rate_artifacts/** -text
data/provenance/population_artifacts/** -text
inputs/illustrative_population/population_artifacts/** -text

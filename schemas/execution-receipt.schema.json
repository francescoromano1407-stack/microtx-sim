        },
        "identity_verification_implies_scientific_readiness": {
          "const": false
        },
        "status": {
          "const": "VERIFIED"
        }
      },
      "required": [
        "status",
        "all_referenced_file_hashes_match",
        "identity_verification_implies_scientific_readiness"

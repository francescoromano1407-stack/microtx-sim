  "required": [
    "$schema",
    "receipt_schema_version",
    "identity_payload",
    "execution_receipt_sha256",
    "identity_verification",
    "execution_gate",
    "scientific_readiness"
  ],
  "title": "microtx-sim technical execution receipt",
  "type": "object",
  "$defs": {
    "absolutePath": {
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:/)",
      "not": {
        "pattern": "\\\\"
      },
      "type": "string"
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/nonemptyString"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "executionVerification": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "$ref": "#/$defs/blockers"
        },
        "campaign_execution_admissible": {
          "const": false
        },
        "expected_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "identity_payload_match": {
          "const": true
        },
        "observed_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "phase": {
          "enum": [
            "PRE_EXECUTION",
            "POST_EXECUTION"
          ]
        },
        "schema_version": {
          "const": "1.0"
        },
        "status": {
          "const": "VERIFIED"
        }
      },
      "required": [
        "schema_version",
        "phase",
        "status",
        "expected_receipt_sha256",
        "observed_receipt_sha256",
        "identity_payload_match",
        "campaign_execution_admissible",
        "blockers"
      ],
      "type": "object"
    },
    "externalCommandIdentity": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "$ref": "#/$defs/nonemptyString"
        },
        "executable_byte_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "executable_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "executable_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "version_output": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "executable_byte_length": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "executable_path": {
              "$ref": "#/$defs/absolutePath"
            },
            "executable_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "status": {
              "const": "AVAILABLE"
            },
            "version_output": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "properties": {
            "executable_byte_length": {
              "type": "null"
            },
            "executable_path": {
              "type": "null"
            },
            "executable_sha256": {
              "type": "null"
            },
            "status": {
              "const": "UNAVAILABLE"
            },
            "version_output": {
              "type": "null"
            }
          }
        }
      ],
      "required": [
        "command",
        "status",
        "executable_path",
        "executable_byte_length",
        "executable_sha256",
        "version_output"
      ],
      "type": "object"
    },
    "fileIdentity": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "hash_scope": {
          "const": "raw file bytes"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "path_base": {
          "const": "repository_root"
        },
        "schema_version": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "schema_version",
        "path",
        "path_base",
        "byte_length",
        "sha256",
        "hash_scope"
      ],
      "type": "object"
    },
    "identifier": {
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "nonemptyString": {
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "nonnegativeInteger": {
      "minimum": 0,
      "type": "integer"
    },
    "projectFileIdentity": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "hash_scope": {
          "const": "raw file bytes"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "path_base": {
          "const": "repository_root"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "path_base",
        "byte_length",
        "sha256",
        "hash_scope"
      ],
      "type": "object"
    },
    "relativePath": {
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:/)\\S(?:[\\s\\S]*\\S)?$",
      "not": {
        "anyOf": [
          {
            "pattern": "(^|/)\\.\\.?(/|$)"
          },
          {
            "pattern": "^/"
          },
          {
            "pattern": "\\\\"
          }
        ]
      },
      "type": "string"
    },
    "semanticIdentity": {
      "additionalProperties": false,
      "properties": {
        "hash_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_for_execution": {
          "type": "boolean"
        },
        "schema_version": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "hash_scope": {
              "const": "declared canonical semantic payload"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "status": {
              "const": "AVAILABLE"
            },
            "unavailable_reason": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "hash_scope": {
              "type": "null"
            },
            "sha256": {
              "type": "null"
            },
            "status": {
              "const": "UNAVAILABLE"
            },
            "unavailable_reason": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        }
      ],
      "required": [
        "schema_version",
        "status",
        "sha256",
        "hash_scope",
        "unavailable_reason",
        "required_for_execution"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
